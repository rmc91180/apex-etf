# Copy to .env for local runs. In GitHub, set these as repository secrets/variables.
DATA_PROVIDER=mock          # mock until a live provider is added
NOTIFIER=console            # console | telegram
TELEGRAM_TOKEN=             # already a repo secret, shared with the ETF scanner
TELEGRAM_CHAT_ID=           # already a repo secret
USER_TIMEZONE=America/New_York

